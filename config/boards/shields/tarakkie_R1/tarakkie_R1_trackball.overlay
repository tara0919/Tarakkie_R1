#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "tarakkie_R1_trackball_shared.dtsi"

/ {
    chosen {
        zmk,matrix-transform = &trackball_transform;
        zmk,battery = &vbatt;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        label = "BATTERY";
        io-channels = <&adc 0>; // D0 is P0.02 (AIN0)
        output-ohms = <1000000>;
        full-ohms = <8500000>; // Match the keyboard halves' AA battery divider calibration.
    };

    trackball_transform: trackball_transform {
        compatible = "zmk,matrix-transform";
        columns = <1>;
        rows = <1>;
        map = <RC(0,0)>;
    };
};

&adc {
    status = "okay";
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,  // D5: SCLK
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,     // D4: SDIO
                <NRF_PSEL(SPIM_MISO, 0, 4)>;     // D4: SDIO
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,  // D5: SCLK
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,     // D4: SDIO
                <NRF_PSEL(SPIM_MISO, 0, 4)>;     // D4: SDIO
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&xiao_d 7 GPIO_ACTIVE_LOW>; // D7: nCS

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; // D10: MOTION
        cpi = <600>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};

/ {
    trackball_input_relay {
        compatible = "zmk,split-peripheral-input-relay";
        relay-channel = <101>;
        device = <&trackball>;
    };
};

/ {
    aliases {
        led-red = &led0;
        led-green = &led1;
        led-blue = &led2;
    };

    leds {
        compatible = "gpio-leds";
        status = "okay";
        led0: led_0 { gpios = <&gpio0 26 GPIO_ACTIVE_LOW>; };
        led1: led_1 { gpios = <&gpio0 30 GPIO_ACTIVE_LOW>; };
        led2: led_2 { gpios = <&gpio0 6 GPIO_ACTIVE_LOW>; };
    };
};
